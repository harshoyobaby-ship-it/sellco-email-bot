# Optional: password to protect the web app (team members need this to sign in)
APP_PASSWORD=your-team-password

# SMTP server settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true

# Login credentials (use an app password for Gmail/Outlook)
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Optional display name and reply address
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=SELLCO
SMTP_REPLY_TO=

# Delay between each email (seconds) — helps avoid spam filters
SEND_DELAY_SECONDS=1
