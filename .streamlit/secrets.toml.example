# Copy to .streamlit/secrets.toml for local web testing.
# On Streamlit Cloud, paste these in: App settings → Secrets

APP_PASSWORD = "choose-a-team-password"

[smtp]
host = "smtp.gmail.com"
port = 587
use_tls = true
username = "your-email@gmail.com"
password = "your-app-password"
from_email = "your-email@gmail.com"
from_name = "SELLCO"

SEND_DELAY_SECONDS = 1
